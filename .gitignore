__pycache__/
*.pyc
.DS_Store

# Render outputs: regenerated by running the scripts, they do not belong in git.
# If a render is a deliverable, move it to assets/ and commit it by hand.
# renders/* not renders/: git cannot re-include a file whose directory is excluded
renders/*
!renders/.gitkeep

# ...except the city, which IS the deliverable rather than a by-product. It is
# small (3 MB) because everything repeated is an instance. city_lots.json is the
# lot table step 03 hands to steps 04-06.
!renders/city.blend
!renders/city_lots.json
!renders/city_final.png

# Reference frames from third-party footage. Study material, not ours to
# redistribute. Kept locally so the look can be compared side by side.
refs/

# Blender
*.blend1
*.blend@

# .agents/skills/ IS tracked: .claude/skills/threejs-* are symlinks into it, so
# a clone without those files would end up with broken skills.

# Harness scratch, not project content.
tasks/
